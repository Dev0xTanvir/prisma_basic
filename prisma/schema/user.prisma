model User {
    id           String       @id @default(uuid())
    name         String       @db.VarChar(255)
    email        String       @unique
    password     String
    activestatus ActiveStatus @default(ACTIVE)
    role         ROLE         @default(USER)
    createdAt    DateTime     @default(now())
    updateAt     DateTime     @updatedAt
    profile    Profile?

    @@map("users")
}
